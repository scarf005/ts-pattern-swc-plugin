{
  "name": "@scarf/ts-pattern-swc-plugin",
  "version": "0.1.2",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": "./transform.mjs",
    "./loader": "./loader.mjs",
    "./register": "./register.mjs",
    "./transform": "./transform.mjs"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@swc/core": "npm:@swc/core@^1.15.33"
  },
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "publish": {
    "include": [
      "README.md",
      "loader.mjs",
      "register.mjs",
      "transform.mjs",
      "loader.d.ts",
      "register.d.ts",
      "transform.d.ts",
      "target/wasm32-wasip1/release/ts_pattern_swc_plugin.wasm.bin"
    ]
  },
  "allowScripts": [
    "npm:@swc/core@1.15.33"
  ]
}
