{
  "name": "ts-pattern-swc-plugin",
  "version": "0.1.0",
  "description": "SWC plugin that compiles ts-pattern match expressions into switch/if-else chains",
  "license": "MIT",
  "type": "commonjs",
  "main": "target/wasm32-wasip1/release/ts_pattern_swc_plugin.wasm",
  "exports": {
    ".": "./target/wasm32-wasip1/release/ts_pattern_swc_plugin.wasm",
    "./wasm": "./target/wasm32-wasip1/release/ts_pattern_swc_plugin.wasm",
    "./loader": "./loader.mjs",
    "./register": "./register.mjs",
    "./run": "./run.mjs",
    "./transform": "./transform.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "ts-pattern-swc": "./run.mjs"
  },
  "files": [
    "target/wasm32-wasip1/release/ts_pattern_swc_plugin.wasm",
    "loader.mjs",
    "register.mjs",
    "run.mjs",
    "transform.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "cargo build --release --target wasm32-wasip1",
    "test": "cargo test",
    "prepack": "npm run build"
  },
  "keywords": [
    "swc-plugin",
    "ts-pattern",
    "pattern-matching"
  ],
  "dependencies": {
    "@swc/core": "^1.15.33"
  },
  "peerDependencies": {
    "ts-pattern": ">=5.0.0"
  },
  "devDependencies": {
    "@swc/binding_core_wasm": "https://github.com/scarf005/swc-wasm/releases/download/binding-core-wasm-plugin-v1.15.33-plugin.1/swc-binding_core_wasm-1.15.33.tgz"
  }
}
