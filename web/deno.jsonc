{
  "fmt": {
    "semiColons": false,
    "proseWrap": "never"
  },
  "tasks": {
    "dev": "deno run -A --unstable-detect-cjs --node-modules-dir npm:vite",
    "build": "deno run -A --unstable-detect-cjs --node-modules-dir npm:vite build",
    "preview": "deno run -A --unstable-detect-cjs --node-modules-dir npm:vite preview",
    "serve": "deno task preview",
    "check": "deno check --unstable-detect-cjs src/main.tsx vite.config.ts src/benchmark.test.ts src/runtime.test.ts src/example-wheel.test.ts",
    "test": "deno test -A --unstable-detect-cjs src/benchmark.test.ts src/runtime.test.ts src/example-wheel.test.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.5",
    "@preact/preset-vite": "npm:@preact/preset-vite@^2.10.2",
    "@preact/signals": "npm:@preact/signals@^2.5.1",
    "monaco-editor": "npm:monaco-editor@^0.55.1",
    "preact": "npm:preact@^10.28.0",
    "ts-pattern": "npm:ts-pattern@^5.8.0",
    "vite": "npm:vite@^7.2.7"
  }
}
