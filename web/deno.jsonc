{
  "fmt": {
    "semiColons": false,
    "proseWrap": "never"
  },
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:vite",
    "build": "deno run -A --node-modules-dir npm:vite build",
    "preview": "deno run -A --node-modules-dir npm:vite preview",
    "serve": "deno task preview",
    "generate:examples": "deno run -A scripts/generate-readme-examples.ts && deno fmt src/generated/readme-examples.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.5",
    "@preact/preset-vite": "npm:@preact/preset-vite@^2.10.2",
    "@preact/signals": "npm:@preact/signals@^2.5.1",
    "@swc/core": "npm:@swc/core@^1.15.33",
    "monaco-editor": "npm:monaco-editor@^0.55.1",
    "preact": "npm:preact@^10.28.0",
    "ts-pattern": "npm:ts-pattern@^5.8.0",
    "vite": "npm:vite@^7.2.7"
  }
}
